# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single-user password gate
# APP_PASSWORD: used ONLY for initial setup / migration seed (it is bcrypt-hashed
# into the app_settings table). It is NOT read at runtime after first login —
# change the password from Settings > Change password instead.
APP_PASSWORD=
AUTH_SECRET=

# SMS webhook shared secret (Phase 3)
SMS_WEBHOOK_SECRET=

# Anthropic (Phase 3 LLM fallback)
ANTHROPIC_API_KEY=

# Timezone fallback (must also be set in Vercel project settings)
TZ=Asia/Colombo